          "enabled": true,
          "selector": "(//label[normalize-space(.)=\"Huyết áp (mmHg)\"]/following::input)[2]",
          "actionType": "input",
          "delayMs": 0,
          "mode": "fixed",
          "fixedValue": "80",
          "keepValues": "",
          "onlyIfEmpty": true
        },
        {
          "id": "rule_d2_chk_sot",
          "enabled": true,
          "selector": "input[formcontrolname=\"canTheoDoiSot\"]",
          "actionType": "checkbox",
          "delayMs": 0,
          "mode": "script",
          "scriptCode": "(triggerVal) => {\n  const temp = Number(triggerVal);\n  if (Number.isNaN(temp) || String(triggerVal).trim() === '') return null;\n  return temp >= 38.5;\n}"
        }
      ]
    },
