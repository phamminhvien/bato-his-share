        {
          "id": "rule_d3_row_soluong",
          "enabled": true,
          "selector": "row: input.inp-so-luong",
          "actionType": "input",
          "delayMs": 0,
          "mode": "script",
          "scriptCode": "(triggerVal, { getVal }) => {\n  if (!triggerVal) return null;\n  if (triggerVal === 'BOI') return '1';\n  const sang = Number(getVal('row: input.inp-sang')) || 0;\n  const toi = Number(getVal('row: input.inp-toi')) || 0;\n  const days = Number(getVal('row: input.inp-so-ngay')) || 0;\n  const total = (sang + toi) * days;\n  console.log('[Demo3-Row] Tính SL dòng hiện tại:', { sang, toi, days, total });\n  return total > 0 ? String(total) : null;\n}"
        }
