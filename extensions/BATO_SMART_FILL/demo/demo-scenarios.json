  "scenarios": [
    {
      "id": "scn_demo_1_full_methods",
      "name": "[Demo 1] Tiếp nhận + Chờ API 550ms (Đủ 4 Phương thức Rule)",
      "enabled": true,
      "urlPattern": "*/demo/demo.html*",
      "isPopup": false,
      "triggerSelector": "#txtNamSinh",
      "triggerEvent": "auto",
      "triggerWaitMs": 0,
      "waitForSettled": true,
      "maxSettleMs": 3000,
      "targets": [
        {
          "id": "rule_d1_fixed_quoctich",
          "enabled": true,
          "selector": "input[name=\"QuocTich\"]",
          "actionType": "input",
          "delayMs": 0,
          "mode": "fixed",
          "fixedValue": "Việt Nam",
          "keepValues": "Nước ngoài",
          "onlyIfEmpty": true
        },
        {
          "id": "rule_d1_mapping_doituong",
          "enabled": true,
          "selector": "#cboDoiTuong",
          "actionType": "select_value",
          "delayMs": 0,
          "mode": "mapping",
          "mappings": [
            {
              "sourceSelector": "#txtTuoi",
              "operator": "lt",
              "matchValue": "6",
              "resultAction": "fill",
              "outputValue": "TE6"
            },
            {
              "sourceSelector": "#txtTuoi",
              "operator": "gte",
              "matchValue": "80",
              "resultAction": "fill",
              "outputValue": "NCT80"
            },
            {
              "sourceSelector": "#txtTuoi",
              "operator": "gte",
              "matchValue": "60",
              "resultAction": "fill",
              "outputValue": "NCT"
            }
          ],
          "mappingFallbackMode": "fixed",
          "mappingFallbackValue": "BHYT"
        },
        {
          "id": "rule_d1_script_nghenghiep",
          "enabled": true,
          "selector": "select[name=\"MaNgheNghiep\"]",
          "actionType": "select_value",
          "delayMs": 0,
          "mode": "script",
          "scriptCode": "(triggerVal, { currentVal, currentText, getVal }) => {\n  const age = Number(getVal('#txtTuoi'));\n  console.log('[Demo1-PT3] Năm sinh:', triggerVal, '| Tuổi sau API:', age, '| Nghề hiện tại:', currentVal, currentText);\n  if (Number.isNaN(age) || getVal('#txtTuoi') === '') return null;\n\n  // Giữ nguyên các nghề đặc thù (VD: 10 - Công an, 11 - Quân đội)\n  const autoManaged = ['1', '6', '3', '4', '139'];\n  if (!autoManaged.includes(currentVal)) {\n    return null;\n  }\n\n  if (age < 6) return '3';     // Trẻ em\n  if (age < 18) return '4';    // Học sinh / Sinh viên\n  if (age >= 60) return '139'; // Hưu trí / Người cao tuổi\n\n  // Độ tuổi 18 - 59: Nếu đang là Nông dân ('6') thì giữ nguyên, còn lại chuyển sang Nông dân ('6')\n  if (currentVal === '6') return null;\n  return '6';\n}"
        },
        {
          "id": "rule_d1_plugin_phongkham_ajax",
          "enabled": true,
          "selector": "#cboPhongKhamAjax",
          "actionType": "auto",
          "delayMs": 0,
          "mode": "plugin",
          "pluginName": "select2_auto_select",
          "pluginParams": "{\n  \"mode\": \"ui_search\",\n  \"sourceRules\": [\n    { \"sourceSelector\": \"#txtTuoi\", \"lt\": 16, \"keyword\": \"Phòng khám Nhi\" },\n    { \"sourceSelector\": \"#txtTuoi\", \"gte\": 60, \"keyword\": \"Phòng khám Lão khoa\" }\n  ],\n  \"keyword\": \"Phòng khám Đa khoa\",\n  \"skipTexts\": [\"Cấp cứu\"]\n}"
        }
      ]
    },
    {
