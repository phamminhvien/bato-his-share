{
  "manifest_version": 3,
  "name": "BATO_SMART_FILL",
  "version": "1.3.0",
  "author": "Vien Pham",
  "description": "Tự động bắt sự kiện thay đổi trên phần tử web, chờ Event/API ngầm của Web hoàn tất rồi thực thi Danh sách Rule theo Kịch bản.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mở BATO_SMART_FILL bên phải màn hình",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "sandbox": {
    "pages": [
      "sandbox/sandbox.html"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/page-network-monitor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "plugins/custom-plugins.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
